<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>Solar Ring Demo</title>

<style>

body{
    margin:0;
    background:#050505;
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
}

svg{
    width:360px;
    height:360px;
}

</style>

</head>

<body>

<svg viewBox="0 0 340 340">

<defs>

<linearGradient id="goldGradient"
    gradientUnits="userSpaceOnUse"
    x1="170" y1="40"
    x2="280" y2="120">

    <stop offset="0%" stop-color="transparent"/>
    <stop offset="100%" stop-color="#FFD25F"/>

</linearGradient>

<linearGradient id="sunsetGradient"
    gradientUnits="userSpaceOnUse"
    x1="260" y1="100"
    x2="285" y2="180">

    <stop offset="0%" stop-color="#FFD25F"/>
    <stop offset="100%" stop-color="#FF6A00"/>

</linearGradient>

<linearGradient id="blueGradient"
    gradientUnits="userSpaceOnUse"
    x1="280" y1="170"
    x2="220" y2="260">

    <stop offset="0%" stop-color="#4F91FF"/>
    <stop offset="100%" stop-color="transparent"/>

</linearGradient>

</defs>

<!-- обычная пунктирная окружность -->

<circle
cx="170"
cy="170"
r="115"

fill="none"

stroke="rgba(255,255,255,.18)"
stroke-width="2"

stroke-dasharray="2 6"/>

<!-- золотой час -->

<path

d="M170 55
A115 115 0 0 1 255 95"

fill="none"

stroke="url(#goldGradient)"
stroke-width="3"

stroke-linecap="round"
stroke-dasharray="2 6"/>

<!-- закат -->

<path

d="M255 95
A115 115 0 0 1 285 170"

fill="none"

stroke="url(#sunsetGradient)"
stroke-width="3"

stroke-linecap="round"
stroke-dasharray="2 6"/>

<!-- синий час -->

<path

d="M285 170
A115 115 0 0 1 235 255"

fill="none"

stroke="url(#blueGradient)"
stroke-width="3"

stroke-linecap="round"
stroke-dasharray="2 6"/>

</svg>

</body>
</html>
